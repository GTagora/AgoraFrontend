2:["$","div",null,{"children":["$","div",null,{"className":"article_main__T4oAV","children":[["$","div",null,{"className":"article_container__RGnE4","children":[["$","$L7",null,{"href":"/blog/an-anthology","className":"article_breadcrumb__WGNPA","children":"An Anthology of Joy and Thought Vol. 1"}],["$","$L9",null,{"className":"article_image__Ep51s","src":"/blog/an-anthology/7.jpg","width":600,"height":600,"alt":"article image"}],["$","p",null,{"className":"article_credit__TCGDn","children":"Image: Stephen Noh"}],["$","h1",null,{"className":"article_title__TTNjf","children":"listen, listen!"}],["$","div",null,{"className":"article_text__jtzJJ","children":["close your eyes… ",["$","br",null,{}],"what do you hear? ",["$","br",null,{}],"the gentle flow and cascade of water~ ",["$","br",null,{}],"  oh, how Your Word is a never-ceasing river of life! ",["$","br",null,{}],"the sounds of children playing as they run worry-free~ ",["$","br",null,{}],"  oh, how much more do You love Your children! ",["$","br",null,{}],"the gentle crunch of each grass bristle under my feet~ ",["$","br",null,{}],"  oh, how You provide for all. Why should I worry? ",["$","br",null,{}],"the gentle wisp of the wind on my ears~ ",["$","br",null,{}],"  oh, how much more beautiful is Your voice! ",["$","br",null,{}],"the simple laughter and conversations of Your creation passing~ ",["$","br",null,{}],"  oh, how beautiful have You made your image-bearers ",["$","br",null,{}],["$","br",null,{}],"but soon… ",["$","br",null,{}],"  the water may sit still ",["$","br",null,{}],"  the children will grow old ",["$","br",null,{}],"  the grass will dry out ",["$","br",null,{}],"  the winds will cease ",["$","br",null,{}],["$","br",null,{}],"but soon the people will worship ",["$","br",null,{}],"  for Your voice is never ceasing. ",["$","br",null,{}],"  how steadfast and wonderful You are. ",["$","br",null,{}]]}]]}],["$","div",null,{"className":"article_buttons__1LFuj","children":[["$","$L7",null,{"href":"/blog/an-anthology/6","className":"article_href__KneUa","children":"<  Previous"}],["$","$L7",null,{"href":"/blog/an-anthology/8","className":"article_href__KneUa","children":"Next  >"}]]}]]}]}]
8:[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}],["$","meta","1",{"charSet":"utf-8"}],["$","title","2",{"children":"Agora | Georgia Tech’s Christian Thought Journal"}],["$","meta","3",{"name":"description","content":"Agora seeks to glorify God as an ecumenical forum and journal of Christian thought. By creating and curating pieces that reflect the vibrant beauty of God’s nature, we offer a collective Christian perspective to the campus dialogue."}],["$","link","4",{"rel":"icon","href":"/logo-black.png","media":"(prefers-color-scheme: light)"}],["$","link","5",{"rel":"icon","href":"/logo-white.png","media":"(prefers-color-scheme: dark)"}],["$","meta","6",{"name":"next-size-adjust"}]]
