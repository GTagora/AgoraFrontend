2:["$","div",null,{"children":["$","div",null,{"className":"article_main__Wl9PI","children":["$","div",null,{"className":"article_container__vMeRP","children":[["$","$L8",null,{"href":"/blog/an-anthology-2","className":"article_breadcrumb__mi4sf","children":"An Anthology of Joy and Thought Vol. 2"}],["$","$La",null,{"className":"article_image__AeBuK","src":"/blog/an-anthology-2/1.jpg","width":600,"height":600,"alt":"article image"}],["$","p",null,{"className":"article_credit__7gr72","children":"Image: Stephen Noh"}],["$","h1",null,{"className":"article_title___hwJH","children":"to my friends..."}],["$","div",null,{"className":"article_text__turON","children":["To my friends in all the places...",["$","br",null,{}],"how do you do?",["$","br",null,{}],"i hope you've been doing wonderfully and that the Lord is blessing you",["$","br",null,{}],"life back in Dallas has been absolutely wonderful",["$","br",null,{}],"it's crazy how much can happen in 4 months,",["$","br",null,{}],"but if you really think about it, that's about the same length as a semester",["$","br",null,{}],"anyways...",["$","br",null,{}],"sometimes it's strange and lonely",["$","br",null,{}],"to think that everyone i meet here only sees the transformed me",["$","br",null,{}],"as i share my testimony and story, i am reminded of his goodness",["$","br",null,{}],"His mercy",["$","br",null,{}],"and His love for me ",["$","br",null,{}],"and it also makes me think of yall ",["$","br",null,{}],"to those who loved and prayed for me ",["$","br",null,{}],"who supported and cried with me ",["$","br",null,{}],"i can't wait to see you again ",["$","br",null,{}],"whether on earth or in heaven ",["$","br",null,{}],"but until then, ",["$","br",null,{}],"until then... ",["$","br",null,{}],"i hope you all continue to run after Him ",["$","br",null,{}],"and until I see you again... ",["$","br",null,{}],"may the Lord continue to bless you"]}],["$","div",null,{"className":"article_buttons__tGDkE","children":[["$","$L8",null,{"href":"/blog/an-anthology-2","className":"article_href__Hx59o","children":"<  Contents"}],["$","$L8",null,{"href":"/blog/an-anthology-2/2","className":"article_href__Hx59o","children":"Next  >"}]]}]]}]}]}]
