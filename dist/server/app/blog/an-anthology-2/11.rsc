2:["$","div",null,{"children":["$","div",null,{"className":"article_main__txbyc","children":["$","div",null,{"className":"article_container__15is9","children":[["$","$L8",null,{"href":"/blog/an-anthology-2","className":"article_breadcrumb__0encu","children":"An Anthology of Joy and Thought Vol. 2"}],["$","$La",null,{"className":"article_image__32jdk","src":"/blog/an-anthology-2/11.jpg","width":600,"height":600,"alt":"article image"}],["$","p",null,{"className":"article_credit__eJlQk","children":"Image: Stephen Noh"}],["$","h1",null,{"className":"article_title__VyT12","children":"a longing"}],["$","div",null,{"className":"article_text__MFcLi","children":["9.20.24 ",["$","br",null,{}],"It’s been a while since I’ve written ",["$","br",null,{}],"  a while since I’ve read ",["$","br",null,{}],"  a while since I’ve spoken to You ",["$","br",null,{}],"Yet my heart longs desperately for You ",["$","br",null,{}],"  longs desperately to hear Your voice ",["$","br",null,{}],"  longs desperately to be with You ",["$","br",null,{}],"Why is it so hard? ",["$","br",null,{}],"  so hard to seek You ",["$","br",null,{}],"  so hard to come to You in my brokenness ",["$","br",null,{}],"But Lord You make it so easy ",["$","br",null,{}],"  so easy as You reach to me ",["$","br",null,{}],"  so easy that You love me endlessly ",["$","br",null,{}],"Lord i know that all You desire is me ",["$","br",null,{}],"  i don’t need to prepare ",["$","br",null,{}],"  i don’t need to look nice ",["$","br",null,{}],"so Lord, call me back home ",["$","br",null,{}],"  into Your arms ",["$","br",null,{}],"  and may i be reminded, that You are always waiting ",["$","br",null,{}]]}],["$","div",null,{"className":"article_buttons__MUm5m","children":[["$","$L8",null,{"href":"/blog/an-anthology-2/10","className":"article_href__ybPk2","children":"<  Previous"}],["$","$L8",null,{"href":"/blog/an-anthology-2/12","className":"article_href__ybPk2","children":"Next  >"}]]}]]}]}]}]
