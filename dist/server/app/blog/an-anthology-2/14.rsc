2:["$","div",null,{"children":["$","div",null,{"className":"article_main__q1efs","children":["$","div",null,{"className":"article_container__Xpx1z","children":[["$","$L8",null,{"href":"/blog/an-anthology-2","className":"article_breadcrumb__qrThb","children":"An Anthology of Joy and Thought Vol. 2"}],["$","$La",null,{"className":"article_image__e791j","src":"/blog/an-anthology-2/14.jpg","width":600,"height":600,"alt":"article image"}],["$","p",null,{"className":"article_credit__47pya","children":"Image: Stephen Noh"}],["$","h1",null,{"className":"article_title__uTB5n","children":"Kintsugi"}],["$","div",null,{"className":"article_text__jVQyZ","children":[["$","b",null,{"children":"Kintsugi"}]," – ",["$","i",null,{"children":"The Japanese art of repairing broken pottery by meticulously joining pieces back together and filling cracks with lacquer dusted with powdered gold, silver, or platinum, thereby highlighting the flaws in the mended object. Also in extended use: an aesthetic or world view characterized by embracing imperfection and treating healing as an essential part of human experience. Frequently as a modifier."}],["$","br",null,{}],["$","br",null,{}],"from dirt and clay You have made me",["$","br",null,{}],"formed in love, and shaped in Your glory",["$","br",null,{}],["$","br",null,{}],"You are my potter",["$","br",null,{}],"and i Your clay",["$","br",null,{}],["$","br",null,{}],"You have called me Your vessel",["$","br",null,{}],"Your lovely vase",["$","br",null,{}],"Your lovely creation",["$","br",null,{}],["$","br",null,{}],"yet in my sin i have broken apart",["$","br",null,{}],"Your pot has shattered",["$","br",null,{}],["$","br",null,{}],"my pieces lie scattered",["$","br",null,{}],"and Your beautiful creation destroyed",["$","br",null,{}],"(is what i think!)",["$","br",null,{}],["$","br",null,{}],"yet You pick up the pieces",["$","br",null,{}],"You embrace them",["$","br",null,{}],["$","br",null,{}],"carefully and lovingly You piece me back together",["$","br",null,{}],"in beautiful gold You mend me",["$","br",null,{}],"You remind me i am so much more than just pieces",["$","br",null,{}],["$","br",null,{}],["$","br",null,{}],"i am renewed in You",["$","br",null,{}],"a beautiful creation now stands",["$","br",null,{}],"in my brokenness You have remade me",["$","br",null,{}],["$","br",null,{}],"like a beautiful piece of kintsugi",["$","br",null,{}],"full of flaws, imperfections, sin",["$","br",null,{}],"yet all the more i am more beautiful than before",["$","br",null,{}],"because the gold of Your Son’s blood has covered me",["$","br",null,{}],"filled the cracks of my soul",["$","br",null,{}],"and i am made all the more beautiful in You",["$","br",null,{}],["$","br",null,{}],["$","br",null,{}],"in my imperfections, brokenness, weakness, does Your glory and mercy shine brightest",["$","br",null,{}],"so Lord, continue to do Your work in me",["$","br",null,{}]]}],["$","div",null,{"className":"article_buttons__z25lG","children":[["$","$L8",null,{"href":"/blog/an-anthology-2/13","className":"article_href__Jr73V","children":"<  Previous"}],["$","$L8",null,{"href":"/blog/an-anthology-2/15","className":"article_href__Jr73V","children":"Next  >"}]]}]]}]}]}]
9:[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}],["$","meta","1",{"charSet":"utf-8"}],["$","title","2",{"children":"Agora | Georgia Tech’s Christian Thought Journal"}],["$","meta","3",{"name":"description","content":"Agora seeks to glorify God as an ecumenical forum and journal of Christian thought. By creating and curating pieces that reflect the vibrant beauty of God’s nature, we offer a collective Christian perspective to the campus dialogue."}],["$","link","4",{"rel":"icon","href":"/logo-black.png","media":"(prefers-color-scheme: light)"}],["$","link","5",{"rel":"icon","href":"/logo-white.png","media":"(prefers-color-scheme: dark)"}],["$","meta","6",{"name":"next-size-adjust"}]]
