2:["$","div",null,{"children":["$","div",null,{"className":"article_main__5FF48","children":["$","div",null,{"className":"article_container__pXjn8","children":[["$","$L8",null,{"href":"/blog/an-anthology-2","className":"article_breadcrumb__BZkG9","children":"An Anthology of Joy and Thought Vol. 2"}],["$","$La",null,{"className":"article_image__WKD2b","src":"/blog/an-anthology-2/10.jpg","width":600,"height":600,"alt":"article image"}],["$","p",null,{"className":"article_credit__5EYLY","children":"Image: Stephen Noh"}],["$","h1",null,{"className":"article_title___Pv_a","children":"simplicity"}],["$","div",null,{"className":"article_text__L7flu","children":["Do do do. ",["$","br",null,{}],"Less thinking, more action",["$","br",null,{}],"That is what I’m told to do everyday",["$","br",null,{}],["$","br",null,{}],"yet why do I feel so incomplete?",["$","br",null,{}],"I do all these things",["$","br",null,{}],"yet why do I still feel so suffocated?",["$","br",null,{}],"I’m doing all the things I’ve been told are good",["$","br",null,{}],"yet why do I continue to remain in angst?",["$","br",null,{}],["$","br",null,{}],["$","br",null,{}],"ah. that’s right…",["$","br",null,{}],"it was never that complicated",["$","br",null,{}],"it never has been",["$","br",null,{}],"it never will be",["$","br",null,{}],["$","br",null,{}],"in simplicity is my joy found",["$","br",null,{}],"the simple truth that You love me so",["$","br",null,{}],"and all You desire is my love",["$","br",null,{}],"so Lord, before anything i do",["$","br",null,{}],"before anything i speak",["$","br",null,{}],"may i just love You",["$","br",null,{}],"to sit here and love You…"]}],["$","div",null,{"className":"article_buttons__IEi4Q","children":[["$","$L8",null,{"href":"/blog/an-anthology-2/9","className":"article_href__ufKfZ","children":"<  Previous"}],["$","$L8",null,{"href":"/blog/an-anthology-2/11","className":"article_href__ufKfZ","children":"Next  >"}]]}]]}]}]}]
