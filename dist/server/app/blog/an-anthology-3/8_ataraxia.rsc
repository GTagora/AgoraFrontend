2:["$","div",null,{"children":["$","div",null,{"className":"article_main__nxCWb","children":["$","div",null,{"className":"article_container__f2GmC","children":[["$","$L7",null,{"href":"/blog/an-anthology-3","className":"article_breadcrumb__J0chS","children":"An Anthology of Joy and Thought Vol. 3"}],["$","$L9",null,{"className":"article_image__JqHls","src":"/blog/an-anthology-3/ataraxia.jpg","width":600,"height":600,"alt":"article image"}],["$","p",null,{"className":"article_credit__Ag0Z3","children":"Image: Stephen Noh"}],["$","h1",null,{"className":"article_title___N0CX","children":"ataraxia"}],["$","div",null,{"className":"article_text__i6zfA","children":["short breaths",["$","br",null,{}],"a tight heart",["$","br",null,{}],"a sense of unease",["$","br",null,{}],["$","br",null,{}],"in the stillness",["$","br",null,{}],"i see a cross",["$","br",null,{}],"“Look to me”, i hear",["$","br",null,{}],["$","br",null,{}],"the brokenness of my flesh",["$","br",null,{}],"the stresses of this world",["$","br",null,{}],"the attacks of the enemy",["$","br",null,{}],["$","br",null,{}],"anxiety ambushes me",["$","br",null,{}],"flooding over me",["$","br",null,{}],"staining my peace",["$","br",null,{}],["$","br",null,{}],"on the mount of Your cross,",["$","br",null,{}],"the place of ataraxia,",["$","br",null,{}],"there, will my peace be found",["$","br",null,{}],["$","br",null,{}],"my flesh brings me down",["$","br",null,{}],"“you’re not good enough”",["$","br",null,{}],"“you will keep falling short”",["$","br",null,{}],["$","br",null,{}],"so, what?",["$","br",null,{}],"only in the light of Your cross",["$","br",null,{}],"my brokenness is made whole",["$","br",null,{}],["$","br",null,{}],"the world asserts its pleasures",["$","br",null,{}],"“you are always behind”",["$","br",null,{}],"“you will never achieve success”",["$","br",null,{}],["$","br",null,{}],"what is success?",["$","br",null,{}],"for if i am one step closer to the cross",["$","br",null,{}],"what worldly stress means anything in eternity",["$","br",null,{}],["$","br",null,{}],"the enemy spreads his lies",["$","br",null,{}],"“it felt good, didn’t it?”",["$","br",null,{}],"“it’s just one little sin”",["$","br",null,{}],["$","br",null,{}],"back away!",["$","br",null,{}],"to follow you is to follow trouble! to follow death!",["$","br",null,{}],"your attacks mean nothing in the face of my Lord!",["$","br",null,{}],["$","br",null,{}],"i am broken",["$","br",null,{}],"i am weak",["$","br",null,{}],"i am troubled",["$","br",null,{}],["$","br",null,{}],"even still,",["$","br",null,{}],"i take step forward",["$","br",null,{}],"in You do i find that strength",["$","br",null,{}],["$","br",null,{}],"a step up the mount",["$","br",null,{}],"to the place of ataraxia",["$","br",null,{}],"to sit at the foot of Your cross",["$","br",null,{}],["$","br",null,{}],"no matter how many mountains,",["$","br",null,{}],"no matter how many trials",["$","br",null,{}],"You’ve already moved them all",["$","br",null,{}],["$","br",null,{}],"the highest place i will ever be",["$","br",null,{}],"is right here at Your feet Lord",["$","br",null,{}],"what more do i need",["$","br",null,{}],["$","br",null,{}],"to be a servant of the Highest One",["$","br",null,{}],"to sit here at Your feet",["$","br",null,{}],"in the place of ataraxia",["$","br",null,{}],["$","br",null,{}],"in the stillness",["$","br",null,{}],"i see a cross",["$","br",null,{}],"and all else becomes clear",["$","br",null,{}],["$","br",null,{}],"ataraxia (n) - calmness untroubled by mental or emotional disquiet"]}],["$","div",null,{"className":"article_buttons__DPZIp","children":[["$","$L7",null,{"href":"/blog/an-anthology-3/7_my-sin-scares-me","className":"article_href__nvzxJ","children":"<  Previous"}],["$","$L7",null,{"href":"/blog/an-anthology-3/9_im-proud-of-you","className":"article_href__nvzxJ","children":"Next  >"}]]}]]}]}]}]
