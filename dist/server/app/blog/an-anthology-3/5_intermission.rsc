2:["$","div",null,{"children":["$","div",null,{"className":"article_main__C2CWB","children":["$","div",null,{"className":"article_container__uzZEt","children":[["$","$L7",null,{"href":"/blog/an-anthology-3","className":"article_breadcrumb__X7KkY","children":"An Anthology of Joy and Thought Vol. 3"}],["$","$L9",null,{"className":"article_image__ndBl8","src":"/blog/an-anthology-3/intermission.jpg","width":600,"height":600,"alt":"article image"}],["$","p",null,{"className":"article_credit__LU0rQ","children":"Image: Stephen Noh"}],["$","h1",null,{"className":"article_title__vuI0D","children":"Intermission"}],["$","div",null,{"className":"article_text__hlimc","children":["the stage quiets",["$","br",null,{}],"the lights brighten",["$","br",null,{}],"the curtains roll across the stage",["$","br",null,{}],"the first act has hit its final page",["$","br",null,{}],["$","br",null,{}],"an ocean of chatter fades in the distance",["$","br",null,{}],"sitting still, i reflect",["$","br",null,{}],"lost, i don’t know what to reap",["$","br",null,{}],"looking down, i weep",["$","br",null,{}],["$","br",null,{}],"“look forward”, a gentle voice says",["$","br",null,{}],"in the quiet, i sit",["$","br",null,{}],"in the stillness, i pray",["$","br",null,{}],"back and forth, the curtains sway",["$","br",null,{}],["$","br",null,{}],"the Author sits next to me",["$","br",null,{}],"“what comes next?”, i ask",["$","br",null,{}],"“do you trust Me?",["$","br",null,{}],"It’s time to wait and see”",["$","br",null,{}],["$","br",null,{}],"glimpses of the scene poke through,",["$","br",null,{}],"the Author is setting the stage",["$","br",null,{}],"fragments of the story roll",["$","br",null,{}],"all pieces, short of a whole",["$","br",null,{}],["$","br",null,{}],"a peek of what is to come",["$","br",null,{}],"He is doing something good",["$","br",null,{}],"joy rushes me like a flood",["$","br",null,{}],"peace flows through my blood",["$","br",null,{}],["$","br",null,{}],"to understand only after the story has been told",["$","br",null,{}],"to trust the One who sits above",["$","br",null,{}],"a reality hard to digest",["$","br",null,{}],"to be expressed in a time of a rest",["$","br",null,{}],["$","br",null,{}],"the lights dim down",["$","br",null,{}],"the stage is set",["$","br",null,{}],"the intermission comes to a close",["$","br",null,{}],"the second act, only the Author knows",["$","br",null,{}],["$","br",null,{}],"this act, the start of many to come",["$","br",null,{}],"what mysteries lie on that stage?",["$","br",null,{}],"in my story, the Author aims to dwell",["$","br",null,{}],"let us see what story He will tell…",["$","br",null,{}]]}],["$","div",null,{"className":"article_buttons__bQK7k","children":[["$","$L7",null,{"href":"/blog/an-anthology-3/4_a-merciful-God-in-a-harsh-wilderness","className":"article_href__mPQuo","children":"<  Previous"}],["$","$L7",null,{"href":"/blog/an-anthology-3/6_honor-and-faith","className":"article_href__mPQuo","children":"Next  >"}]]}]]}]}]}]
